{
  "name": "@ryanlee2007/dsh-tool-session-tree",
  "description": "session_tree tool, /tree /fork /clone commands, and system-prompt section backed by the append-only session-tree store.",
  "version": "0.1.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../../scripts/build.mjs tool",
    "watch": "node ../../../scripts/build.mjs tool"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-commands": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1",
    "@ryanlee2007/dsh-pi-agent-session-tree": "^0.1.3"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lizhuoyuan41-droid/dsh-session-tree-extension.git"
  },
  "bugs": {
    "url": "https://github.com/lizhuoyuan41-droid/dsh-session-tree-extension/issues"
  }
}
